# Public base URL of the site (used for canonical links, sitemap, share cards)
NEXT_PUBLIC_SITE_URL=https://ifenkili.xyz

# --- Form delivery (optional in Phase 1) ---
# If these are set, newsletter signups and story submissions are emailed to you
# via Resend (https://resend.com). If unset, they are appended to ./data/*.ndjson
# on the server instead (fine for low volume; mount a Fly volume to persist).
RESEND_API_KEY=
# Verified sender on your Resend account, e.g. "IFENKILI <hello@ifenkili.xyz>"
MAIL_FROM=
# Where submissions and signups are delivered
MAIL_TO=

# Directory for on-disk fallback storage of form submissions
INBOX_DIR=./data
